{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "clickkaar": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/clickkaar",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "allowedCommonJsDependencies": ["aos"],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/assets/images/Product Images Pro Gear/Audio Mic",
                "output": "/products"
              },
              {
                "glob": "**/*",
                "input": "src/assets/images/Product Images Pro Gear/Camera",
                "output": "/products"
              },
              {
                "glob": "**/*",
                "input": "src/assets/images/Product Images Pro Gear/Card",
                "output": "/products"
              },
              {
                "glob": "**/*",
                "input": "src/assets/images/Product Images Pro Gear/Card Reader",
                "output": "/products"
              },
              {
                "glob": "**/*",
                "input": "src/assets/images/Product Images Pro Gear/Flash",
                "output": "/products"
              },
              {
                "glob": "**/*",
                "input": "src/assets/images/Product Images Pro Gear/Gimble",
                "output": "/products"
              },
              {
                "glob": "**/*",
                "input": "src/assets/images/Product Images Pro Gear/Lens",
                "output": "/products"
              },
              {
                "glob": "**/*",
                "input": "src/assets/images/Product Images Pro Gear/Lens Filter",
                "output": "/products"
              },
              {
                "glob": "**/*",
                "input": "src/assets/images/Product Images Pro Gear/Light Stand",
                "output": "/products"
              },
              {
                "glob": "**/*",
                "input": "src/assets/images/Product Images Pro Gear/Modifiere",
                "output": "/products"
              },
              {
                "glob": "**/*",
                "input": "src/assets/images/Product Images Pro Gear/Reflector & Diffuser",
                "output": "/products"
              },
              {
                "glob": "**/*",
                "input": "src/assets/images/Product Images Pro Gear/Trasmitter",
                "output": "/products"
              },
              {
                "glob": "**/*",
                "input": "src/assets/images/Product Images Pro Gear/Tripod",
                "output": "/products"
              },
              {
                "glob": "**/*",
                "input": "src/assets/images/Product Images Pro Gear/Video Lights",
                "output": "/products"
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/aos/dist/aos.css",
              "src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "2MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "clickkaar:build:production"
            },
            "development": {
              "buildTarget": "clickkaar:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": "df432f32-1962-440f-a2e2-e5d557c3fc93"
  }
}
